---
import { navigation } from '../data/navigation';
interface Props { enquiryHref?: string; }
const { enquiryHref } = Astro.props;
const ctaHref = enquiryHref ?? '/#schedule';
const ctaLabel = enquiryHref ? 'Enquire' : 'Find your class';
---
<nav id="nav" aria-label="Main navigation" class="sticky top-0 z-100 bg-white/92 backdrop-blur-[16px] border-b border-rose/6 transition-shadow duration-300">
  <div class="max-w-[1280px] mx-auto flex items-center justify-between gap-4 px-5 h-16">
    <a href="/" class="flex items-center gap-2.5 no-underline shrink-0">
      <img src="/images/logos/logo-mark-bold.png" alt="Latin Addiction logo" width="48" height="48" class="h-12 w-auto -my-1.5" style="filter:brightness(0)" />
      <span class="font-display font-[800] text-[1rem] min-[380px]:text-[1.25rem] whitespace-nowrap text-dark">Latin Addiction</span>
    </a>
    <ul class="hidden lg:flex items-center gap-5 xl:gap-7 list-none">
      {navigation.map(item => <li>
        {item.children ? <details class="nav-dropdown relative">
          <summary class="nav-link cursor-pointer text-[.82rem] font-medium text-muted">
            {item.label}<span aria-hidden="true" class="ml-1 text-[.65rem]">⌄</span>
          </summary>
          <ul class="dropdown-panel">
            {item.children.map(child => <li><a href={child.href}>{child.label}</a></li>)}
          </ul>
        </details> : <a href={item.href} class="nav-link text-[.82rem] font-medium text-muted no-underline">{item.label}</a>}
      </li>)}
    </ul>
    <a href={ctaHref} class="hidden lg:inline-flex shrink-0 bg-rose text-white text-[.78rem] font-semibold py-2.5 px-5 rounded-full no-underline hover:bg-rose-dark">{ctaLabel}</a>
    <button id="ham" class="lg:hidden bg-transparent border-none cursor-pointer p-3 min-w-[44px] min-h-[44px] flex flex-col justify-center items-center" aria-label="Menu" aria-controls="mob-menu" aria-expanded="false">
      <span class="block w-[22px] h-[2px] bg-dark my-[2.5px]"></span>
      <span class="block w-[22px] h-[2px] bg-dark my-[2.5px]"></span>
      <span class="block w-[22px] h-[2px] bg-dark my-[2.5px]"></span>
    </button>
  </div>
  <div id="mob-menu" class="hidden absolute top-16 left-0 right-0 bg-white border-b border-rose/6 px-5 pt-4 pb-6 flex-col gap-2 overflow-y-auto" style="max-height:calc(100dvh - 64px);overscroll-behavior:contain">
    {navigation.map(item => item.children ? <div class="py-2 border-b border-rose/6">
      <span class="block text-[.7rem] font-semibold uppercase tracking-[.1em] text-rose pb-2">{item.label}</span>
      <div class="flex flex-wrap gap-1">
        {item.children.map(child => <a href={child.href} class="mob-link inline-flex items-center min-h-[44px] text-[.88rem] py-2 px-3 text-muted no-underline bg-rose/6 rounded-lg hover:bg-rose/14 hover:text-rose">{child.label}</a>)}
      </div>
    </div> : <a href={item.href} class="mob-link block text-[.95rem] font-medium text-dark no-underline py-2.5 border-b border-rose/6">{item.label}</a>)}
    <a href={ctaHref} class="mob-link block text-rose font-semibold no-underline py-2 mt-2">{enquiryHref ? 'Make an enquiry' : 'Find your class'} →</a>
  </div>
  <noscript><style>#ham{display:none}#mob-menu{display:flex;position:static;max-height:none!important}@media(min-width:1024px){#mob-menu{display:none}}</style></noscript>
</nav>
<style>
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .nav-link { white-space: nowrap; }
  .nav-link:hover, details[open] > summary { color: #be123c; }
  .dropdown-panel { position: absolute; top: calc(100% + 16px); left: 50%; transform: translateX(-50%); min-width: 205px; padding: .4rem; background: white; border: 1px solid rgba(225,29,72,.12); border-radius: 12px; list-style: none; box-shadow: 0 8px 32px rgba(17,17,17,.1); }
  .dropdown-panel a { display: block; padding: .75rem 1rem; font-size: .82rem; color: #555; text-decoration: none; border-radius: 8px; white-space: nowrap; }
  .dropdown-panel a:hover { background: rgba(225,29,72,.1); color: #be123c; }
  #mob-menu.open { display: flex; }
  :global(#nav.scrolled) { box-shadow: 0 4px 30px rgba(17,17,17,.06); }
</style>
<script>
  const ham = document.getElementById('ham');
  const mobMenu = document.getElementById('mob-menu');
  function closeMobileMenu() {
    mobMenu?.classList.remove('open');
    ham?.setAttribute('aria-expanded', 'false');
  }
  ham?.addEventListener('click', () => {
    const open = mobMenu?.classList.toggle('open');
    ham.setAttribute('aria-expanded', String(Boolean(open)));
  });
  mobMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMobileMenu));
  window.matchMedia('(min-width: 1024px)').addEventListener('change', event => {
    if (event.matches) closeMobileMenu();
  });
  const dropdowns = document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown');
  dropdowns.forEach(dropdown => {
    dropdown.addEventListener('toggle', () => {
      if (dropdown.open) dropdowns.forEach(other => { if (other !== dropdown) other.open = false; });
    });
    dropdown.addEventListener('focusout', event => {
      if (!dropdown.contains((event as FocusEvent).relatedTarget as Node | null)) dropdown.open = false;
    });
  });
  document.addEventListener('click', event => {
    dropdowns.forEach(dropdown => { if (!dropdown.contains(event.target as Node)) dropdown.open = false; });
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    if (mobMenu?.classList.contains('open')) { closeMobileMenu(); ham?.focus(); }
    dropdowns.forEach(dropdown => {
      if (dropdown.open) { dropdown.open = false; dropdown.querySelector('summary')?.focus(); }
    });
  });
  const nav = document.getElementById('nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 10);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
