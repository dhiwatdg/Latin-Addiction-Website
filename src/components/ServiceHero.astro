---
import { EMAIL } from '../data/locations';
interface Props { eyebrow: string; title: string; href?: string; label?: string; }
const { eyebrow, title, href, label } = Astro.props;
---
<header class="service-hero">
  <div class="hero-glow-left" aria-hidden="true"></div>
  <div class="hero-glow-right" aria-hidden="true"></div>
  <div class="service-shell relative z-10">
    <p class="service-eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <div class="service-intro"><slot /></div>
    {href && <div class="service-actions">
      <a class="btn-rose" href={href} target="_blank" rel="noopener">{label}</a>
      <p class="service-email">Prefer email? <a href={`mailto:${EMAIL}`}>Email us</a></p>
    </div>}
  </div>
</header>
