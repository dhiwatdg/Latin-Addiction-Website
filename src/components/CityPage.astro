---
import BaseLayout from '../layouts/BaseLayout.astro';
import { locations, whatsappUrl, mapsUrl } from '../data/locations';
import { cityOffers, type CitySlug } from '../data/pricing';
import { reviews, reviewExcerpt } from '../data/reviews';
import '../styles/cities.css';
import { cityClassService } from '../data/structured-data';

interface Props { city: CitySlug; }
const { city } = Astro.props;
const loc = locations.find(l => l.slug === city)!;
const offer = cityOffers.find(o => o.city === city)!;
const reading = city === 'reading';
const mk = city === 'milton-keynes';
const beginnerTime = reading ? '8pm' : '7:15pm';
const street = mk ? '1 Savoy Crescent, Theatre District' : reading ? '84 Queen’s Road' : '29A Sharmon Crescent';
const parking = mk ? 'Free parking around the venue from 6pm.' : reading ? 'Free venue parking — register your vehicle at the parking kiosk when you arrive to avoid a fine.' : 'Free street parking.';
const waUrl = whatsappUrl(`Hi! I have a question about Bachata classes in ${loc.name}.`);
const priceHref = `/pricing/#${city}`;
const review = reviews.find(r => r.author === 'G V James')!;
const team = [
  { name: 'Dhiwa', src: '/images/optimised/founders-96.webp', position: 'left center' },
  { name: 'Gloria', src: '/images/instructors/Gloria.jpg', position: 'center top' },
  { name: 'Chido', src: '/images/instructors/Chido.jpg' },
  { name: 'Daniella', src: '/images/instructors/Daniella.jpeg' },
  { name: 'Imogen', src: '/images/instructors/Imogen.jpg' },
  { name: 'Megan', src: '/images/instructors/Meg.jpg' },
  { name: 'Irina', src: '/images/instructors/Irina.jpg' },
];
const sessions = reading ? [
  { time: '8:00pm', groups: [
    { name: 'Beginners · 8pm', description: 'Rhythm, basic steps and your first partner moves. No experience needed.' },
    { name: 'Intermediate · 8pm', description: 'Body movement, musical interpretation and connection.' },
  ] },
  { time: '9:00pm', groups: [
    { name: 'Improvers · 9pm', description: 'Develop patterns, connection and confidence.' },
    { name: 'Advanced · 9pm', description: 'Explore styling, partner work and musicality.' },
  ] },
] : [
  { time: '7:15pm', groups: [{ name: 'Beginners', description: 'Rhythm, basic steps and your first partner moves. No experience needed.' }] },
  { time: '8:15pm', groups: [{ name: 'Improver / Intermediate', description: mk ? 'Develop your patterns, connection and personal style.' : 'Develop your patterns, connection and musicality.' }] },
  { time: '9:15pm', groups: [{ name: 'Intermediate / Advanced', description: 'Explore styling, partner work and musicality.' }] },
];
---

<BaseLayout title={`Bachata Classes in ${loc.name}`} description={`Learn Bachata every ${loc.day} at ${loc.venue}, ${loc.name}. Free first beginner class, no partner needed. Timetable, directions and prices.`}>
  <section class="city-hero bg-dark text-white">
    <div class="hero-bg-blur" style={`--hero-small:url('/images/optimised/${reading ? 'reading' : mk ? 'mk' : 'leicester'}-bg-640.webp');--hero-medium:url('/images/optimised/${reading ? 'reading' : mk ? 'mk' : 'leicester'}-bg-1280.webp');--hero-large:url('/images/optimised/${reading ? 'reading' : mk ? 'mk' : 'leicester'}-bg-1920.webp');`} aria-hidden="true"></div>
    <div class="city-hero-shade" aria-hidden="true"></div>
    <div class="hero-glow-left" aria-hidden="true"></div>
    <div class="city-shell city-hero-content">
      <p class="city-eyebrow">Bachata classes · {loc.name}</p>
      <h1>Bachata classes in <span>{loc.name}</span></h1>
      <p class="city-hero-intro">Every {loc.day} at {loc.venue}.<br />Complete beginners start at {beginnerTime}.</p>
      <div class="city-actions">
        <a href="#schedule" class="btn-rose">See times &amp; directions <span aria-hidden="true">↓</span></a>
        <a href={waUrl} class="btn-white-outline" target="_blank" rel="noopener">Ask on WhatsApp</a>
      </div>
    </div>
  </section>

  <section id="schedule" class="city-section bg-white" aria-labelledby="city-schedule-heading">
    <div class="city-shell city-practical">
      <div>
        <p class="city-eyebrow">Classes &amp; social dancing</p>
        <h2 id="city-schedule-heading" class="city-heading">Your {loc.day} timetable</h2>
        <ol class="city-timetable">
          <li class="city-session city-doors">
            <p class="city-time">{loc.doorsOpen}</p>
            <div><h3>Doors open</h3><p>Arrive and meet the team.</p></div>
          </li>
          {sessions.map(session => <li class="city-session">
            <p class="city-time">{session.time}</p>
            <div class:list={['city-groups', reading && 'city-parallel-groups']}>
              {session.groups.map(group => <div><h3>{group.name}</h3><p>{group.description}</p></div>)}
            </div>
          </li>)}
          <li class="city-session city-social">
            <p class="city-time">{reading ? '10:00' : '10:15'}–11:00pm</p>
            <div><h3>Free social dancing</h3><p>Practise and enjoy the music.</p></div>
          </li>
        </ol>
        {reading ? <p class="city-schedule-note">At 8pm and 9pm, the two levels run as separate groups in the same room. You can attend up to two classes per night.</p> : !mk && <p class="city-schedule-note">Each class lasts one hour.</p>}
      </div>
      <aside class="city-venue" aria-labelledby="city-venue-heading">
        <p class="city-eyebrow">Finding us</p>
        <h2 id="city-venue-heading">{loc.venue}</h2>
        <address>{street}, {loc.name} {loc.postcode}</address>
        <div class:list={['city-parking', reading && 'city-parking-important']}>
          <h3>Parking</h3><p>{parking}</p>
        </div>
        <a href={mapsUrl(loc.mapsQuery)} class="city-link" target="_blank" rel="noopener">Get directions <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </section>

  <section class="city-section city-booking-section" aria-labelledby="city-prices-heading">
    <div class="city-shell city-booking">
      <div class="city-prices">
        <p class="city-eyebrow">Tickets &amp; passes</p>
        <h2 id="city-prices-heading" class="city-heading">Prices</h2>
        {mk ? <p class="city-flat-price"><strong>£10</strong> for the whole night, including all classes and the social.</p> : <>
          <dl class="city-dropins">{offer.dropIn.options.map(option => <div><dt>{option.label}</dt><dd>£{option.amountPence / 100}</dd></div>)}</dl>
          <p class="city-price-note">Social dancing is free.</p>
        </>}
        <a href={priceHref} class="btn-rose">See {loc.name} tickets &amp; passes <span aria-hidden="true">→</span></a>
        <p class="city-payment-note">Cash and card accepted at the door. <strong>£2 Student &amp; NHS discount at the door only</strong>, unavailable online.</p>
      </div>
      <div class="city-first-visit">
        <h2 class="city-heading">Your first visit</h2>
        <p>Your first beginner class is free, once per person across Latin Addiction. No partner, experience or advance booking needed. Wear comfortable clothes and shoes.</p>
        <p><strong>Already dance Bachata?</strong> Choose the class that suits your experience, or <a href={whatsappUrl(`Hi! I'm not sure which level to join in ${loc.name}.`)} class="city-link" target="_blank" rel="noopener">ask us which level to join</a>.</p>
        <div class="city-newcomer">
          <h3>After your trial</h3>
          <p>The <strong>£20 newcomer pass</strong> covers four consecutive paid beginner weeks in this city. It starts with your first paid beginner class; missed weeks count.</p>
          <p>Regular Fixed and Flexi passes are also city-specific. <a href={priceHref} class="city-link">See this city’s tickets and passes</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="city-section bg-white" aria-labelledby="city-proof-heading">
    <div class="city-shell city-proof">
      <div>
        <p class="city-eyebrow">Our community</p>
        <h2 id="city-proof-heading" class="city-heading">What our students say</h2>
        {reading && <div class="city-team">
          <div class="city-team-portraits">{team.map(person => <img src={person.src} alt={person.name} width="40" height="40" loading="lazy" style={`object-position:${person.position || 'center'}`} />)}</div>
          <a href="/about/" class="city-link">Meet your Reading team <span aria-hidden="true">→</span></a>
        </div>}
      </div>
      <figure class="city-review-card">
        <div class="city-review-stars" aria-label="5 out of 5 stars"><span aria-hidden="true">★★★★★</span></div>
        <blockquote>“{reviewExcerpt(review.text)}”</blockquote>
        <figcaption>{review.author} · Google review excerpt</figcaption>
        <a href="/reviews/" class="city-link">Read more student reviews <span aria-hidden="true">→</span></a>
      </figure>
    </div>
  </section>

  <section class="city-closing bg-dark text-white" aria-labelledby="city-contact-heading">
    <div class="city-shell city-closing-content">
      <div><h2 id="city-contact-heading">Questions before you come?</h2><p>Message us on WhatsApp if you need help. Otherwise, simply come along.</p></div>
      <a href={waUrl} class="btn-rose" target="_blank" rel="noopener">Ask on WhatsApp</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(cityClassService(loc, street))} />
</BaseLayout>
