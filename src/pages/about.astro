---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceHero from '../components/ServiceHero.astro';
import ServiceContact from '../components/ServiceContact.astro';
import { whatsappUrl } from '../data/locations';
import '../styles/services.css';
const enquiry = { message: "Hi! I'd like to find out about Latin Addiction classes, private tuition or an event.", label: 'Chat with us on WhatsApp' };
const waUrl = whatsappUrl(enquiry.message);
---
<BaseLayout title="About Latin Addiction — Dhiwa & Gloria" description="Meet Dhiwa and Gloria, co-founders of Latin Addiction. Weekly Bachata classes and tailored Salsa and Bachata experiences in Milton Keynes, Leicester and Reading." enquiry={enquiry}>
  <ServiceHero eyebrow="About Latin Addiction" title="The people behind Latin Addiction">
    <p>Weekly Bachata classes and tailored Salsa and Bachata experiences in Milton Keynes, Leicester and Reading.</p>
  </ServiceHero>
  <section class="service-section">
    <div class="service-shell service-copy center">
      <p>Latin Addiction brings people together through dance. Whether you’re taking your first steps, developing your technique or planning something special for a group, we want you to feel welcome and enjoy learning.</p>
    </div>
  </section>
  <section class="service-section soft">
    <div class="service-shell">
      <h2>Meet Dhiwa and Gloria</h2>
      <p class="service-copy mb-8">Latin Addiction is led by co-founders Dhiwa and Gloria, supported by a team of more than ten instructors across our three cities.</p>
      <div class="service-grid">
        <article class="service-card founder-card">
          <div class="founder-portrait"><img src="/images/optimised/founders-400.webp" srcset="/images/optimised/founders-400.webp 400w, /images/optimised/founders-800.webp 800w" sizes="376px" width="400" height="596" loading="lazy" alt="Dhiwa, co-founder of Latin Addiction" /></div>
          <h3>Dhiwa</h3><p class="service-role">Co-founder &amp; Instructor</p>
          <p>Dhiwa co-founded Latin Addiction in July 2021, building a welcoming Bachata community with weekly classes in Milton Keynes, Leicester and Reading. His teaching focuses on confidence, technique and partner connection. Alongside the school, he organises Bachata and SBK social events and regularly teaches and DJs at festivals, congresses and events across the UK.</p>
        </article>
        <article class="service-card founder-card">
          <img src="/images/instructors/Gloria.jpg" width="160" height="160" loading="lazy" style="object-position:center top" alt="Gloria, co-founder of Latin Addiction" />
          <h3>Gloria</h3><p class="service-role">Co-founder &amp; Instructor</p>
          <p>Gloria trained in ballet for over ten years before discovering Salsa and Bachata in 2019. Her teaching emphasises follower technique, body mechanics, clear communication and dancer safety, helping dancers develop confidence and connection. She co-runs Latin Addiction with Dhiwa, teaching weekly classes and workshops across the three cities.</p>
        </article>
      </div>
      <div class="service-followup">
        <p>Together, Dhiwa and Gloria have developed a structured teaching methodology and deliver Bachata Sensual Technique workshops across the UK. They are regularly invited to teach and DJ at festivals and events nationwide.</p>
      </div>
    </div>
  </section>
  <section class="service-section">
    <div class="service-shell">
      <h2>How we teach</h2>
      <div class="service-grid three">
        <article class="service-card"><h3>Understand the movement.</h3><p>We explain the technique behind the steps so you can build skills you understand and use.</p></article>
        <article class="service-card"><h3>Look after each other.</h3><p>Comfortable movement, respectful partner connection and consent belong at the heart of social dancing.</p></article>
        <article class="service-card"><h3>Enjoy the experience.</h3><p>Learning should leave room for music, laughter and meeting people. Our weekly class nights include a free social where you can practise.</p></article>
      </div>
    </div>
  </section>
  <section class="service-section soft">
    <div class="service-shell">
      <h2>Find your way into Latin dance</h2>
      <div class="service-grid three">
        <article class="service-card"><h3>Weekly Bachata classes</h3><p>Our weekly public classes focus on Bachata, with different levels available across Milton Keynes, Leicester and Reading. Complete beginners are welcome, and you don’t need to bring a partner.</p><a class="service-link" href="/classes/">Explore weekly classes →</a></article>
        <article class="service-card"><h3>Private Salsa &amp; Bachata lessons</h3><p>Individual attention for you, your partner or a small private group. Tell us what you would like to learn, and we’ll discuss the right approach.</p><a class="service-link" href={whatsappUrl("Hi! I'd like to arrange private Salsa or Bachata lessons. Can we discuss availability?")}>Ask about private lessons →</a></article>
        <article class="service-card"><h3>Corporate workshops &amp; event hire</h3><p>Bring people together with a tailored Latin dance experience. We offer Salsa and Bachata, including cross-body and Cuban Salsa, with the session shaped around your group and occasion.</p><div class="service-links"><a class="service-link" href="/services/corporate/">Explore corporate workshops →</a><a class="service-link" href="/services/hire-us/">Explore event hire →</a></div></article>
      </div>
    </div>
  </section>
  <ServiceContact title="Let’s find the right experience for you" href={waUrl} label="Chat with us on WhatsApp">
    <p>Looking for a weekly class, private tuition or something for your event? Tell us what you have in mind.</p>
  </ServiceContact>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Organization', '@id': 'https://latinaddiction.co.uk/#organization',
    name: 'Latin Addiction', url: 'https://latinaddiction.co.uk', foundingDate: '2021-07',
    founder: [{ '@type': 'Person', name: 'Dhiwa' }, { '@type': 'Person', name: 'Gloria' }],
    logo: 'https://latinaddiction.co.uk/images/logos/logo-mark-golden-tight.png',
    description: 'Weekly Bachata classes and tailored Salsa and Bachata private tuition, corporate workshops and event experiences in Milton Keynes, Leicester and Reading.',
    sameAs: ['https://www.instagram.com/latinaddictionuk', 'https://www.facebook.com/LatinAddictionUK', 'https://www.tiktok.com/@latin.addiction.uk', 'https://www.youtube.com/@LatinAddictionUK']
  })} />
</BaseLayout>
