---
import BaseLayout from '../layouts/BaseLayout.astro';
import { locations, whatsappUrl, mapsUrl } from '../data/locations';
import { cityOffers, bookingRules, formatPrice } from '../data/pricing';
import '../styles/booking.css';
---
<BaseLayout title="Class prices & passes" description="Choose Milton Keynes, Leicester or Reading for city-specific Bachata tickets and passes. First beginner class free. Newcomer pass £20." showStickyBar={false}>
  <div class="booking-page">
    <header class="booking-hero">
      <div class="booking-shell">
        <h1>Your next night of Bachata.</h1>
        <p>First time? Your first beginner class is free. Already dancing? Find the right ticket or pass for your city.</p>
        <a class="booking-text-link light" href="/services/private-coaching/">Looking for private coaching?</a>
      </div>
    </header>
    <div class="booking-shell booking-content">
      <section id="memberships" aria-labelledby="choose-city">
        <h2 id="choose-city">Where will you dance?</h2>
        <p>Choose your city to see its timetable and prices. All passes are city-specific.</p>
        <nav class="city-choices" aria-label="Choose your class city">
          {locations.map(loc => <a href={`#${loc.slug}`} data-city-link={loc.slug}>
            <span class="city-day">{loc.day}s</span><strong>{loc.name}</strong><span class="city-choice-action">See prices <span aria-hidden="true">→</span></span>
          </a>)}
        </nav>
        <p id="city-prompt" hidden>Pick a city above to see your options. No payment is needed for your first beginner class.</p>
      </section>
      {cityOffers.map(offers => {
        const loc = locations.find(item => item.slug === offers.city)!;
        return <section id={offers.city} data-city-panel class="city-pricing" aria-labelledby={`${offers.city}-heading`}>
          <header class="city-heading">
            <div><h2 id={`${offers.city}-heading`} tabindex="-1">{loc.name} · {loc.day}s</h2><p>{loc.venue} · Doors {loc.doorsOpen}</p></div>
            <a class="booking-text-link" href={`/${loc.slug}/#schedule`}>Timetable & venue</a>
          </header>
          <div class="first-visit">
            <div><h3>Your first beginner class is free.</h3><p>Join us at {offers.firstClass === '19:15' ? '7:15pm' : '8:00pm'}. No partner, experience or advance booking needed. Just turn up.</p>
              <div class="booking-actions"><a class="btn-rose" href={mapsUrl(loc.mapsQuery)}>Get directions</a><a class="booking-text-link" href={whatsappUrl(`Hi! I have a question about ${loc.name} classes and passes.`)}>Ask a question on WhatsApp</a></div>
            </div>
            <div><h3>Loved your first class?</h3><p>{bookingRules.newcomer}</p><a class="booking-text-link" data-offer-id={offers.newcomer.id} href={offers.newcomer.storeUrl}>Get the {loc.name} newcomer pass · {formatPrice(offers.newcomer.amountPence)}</a></div>
          </div>
          <section id={`${loc.slug}-tickets`} class="booking-section" aria-labelledby={`${loc.slug}-drop-in`}>
            <h3 id={`${loc.slug}-drop-in`}>Just coming for one night?</h3><p>Pay cash or card at the door, or book online. Social dancing is free.</p>
            <dl class="drop-in-prices">{offers.dropIn.options.map(option => <div><dt>{option.label}</dt><dd>{formatPrice(option.amountPence)}</dd></div>)}</dl>
            <a class="btn-rose" data-offer-id={offers.dropIn.id} href={offers.dropIn.storeUrl}>{loc.slug === 'milton-keynes' ? 'Get a Milton Keynes night ticket' : `Choose a ${loc.name} drop-in`} on SumUp</a>
            {loc.slug !== 'milton-keynes' && <p class="booking-note">Choose your number of classes on the next page before paying.</p>}
            <details class="booking-details"><summary>Which night does my ticket cover?</summary><p>{bookingRules.dropIn}</p></details>
          </section>
          <section class="booking-section" aria-labelledby={`${loc.slug}-passes`}>
            <h3 id={`${loc.slug}-passes`}>Make it a regular thing.</h3><p>Choose Fixed for consecutive weeks, or Flexi if you need room for missed nights. {loc.name} only.</p>
            <div class="pass-options">{offers.memberships.map(pass => <section class="pass-option" aria-labelledby={pass.id}>
              <h4 id={pass.id}>{pass.weeks}-week passes</h4>
              <p>Fixed: {pass.weeks} consecutive weeks.<br/>Flexi: {pass.weeks} nights within {pass.flexiValidityWeeks} weeks.</p>
              <table><caption class="sr-only">{loc.name} {pass.weeks}-week pass prices</caption><thead><tr><th scope="col">Classes each night</th><th scope="col">Fixed</th><th scope="col">Flexi</th></tr></thead>
                <tbody>{pass.rows.map(row => <tr><th scope="row">{row.label}</th><td>{formatPrice(row.fixedPence)}</td><td>{formatPrice(row.flexiPence)}</td></tr>)}</tbody>
              </table>
              <a class="btn-rose" data-offer-id={pass.id} aria-label={`Choose ${pass.weeks === 8 ? 'an' : 'a'} ${pass.weeks}-week ${loc.name} pass on SumUp`} href={pass.storeUrl}>Choose {pass.weeks === 8 ? 'an' : 'a'} {pass.weeks}-week pass on SumUp</a>
              <p class="booking-note">Select {loc.slug === 'milton-keynes' ? 'Fixed or Flexi' : 'your class count and Fixed or Flexi'} on the next page.</p>
            </section>)}</div>
            <details class="booking-details"><summary>When does my pass start, and what if I miss a week?</summary><p>{bookingRules.fixed}</p><p>{bookingRules.flexi}</p><p>{bookingRules.city}</p></details>
          </section>
        </section>;
      })}
      <aside class="booking-help"><h2>A couple of things to know.</h2><p>{bookingRules.discount}</p><p>Online tickets are sold through our SumUp store. Check the city and selected options before you pay.</p><a class="booking-text-link" href={whatsappUrl("Hi! I need help choosing a class or pass.")}>Need a hand choosing? Message us</a></aside>
    </div>
  </div>
</BaseLayout>
<script>
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-city-panel]'));
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-city-link]'));
  const prompt = document.getElementById('city-prompt');
  let selected: HTMLElement | undefined;
  function selectFromHash(moveFocus = false) {
    const hash = window.location.hash.slice(1);
    const match = panels.find(panel => hash === panel.id || hash.startsWith(panel.id + '-'));
    if (match || !hash || hash === 'memberships') selected = match;
    panels.forEach(panel => { panel.hidden = panel !== selected; });
    links.forEach(link => {
      if (link.dataset.cityLink === selected?.id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
    if (prompt) prompt.hidden = !!selected;
    if (selected && match && moveFocus) {
      const target = document.getElementById(hash) ?? selected;
      target.scrollIntoView({ block: 'start' });
      document.getElementById(selected.id + '-heading')?.focus({ preventScroll: true });
    }
  }
  selectFromHash();
  window.addEventListener('hashchange', () => selectFromHash(true));
</script>
