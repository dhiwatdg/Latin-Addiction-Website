---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import ServiceContact from '../../components/ServiceContact.astro';
import { whatsappUrl } from '../../data/locations';
import '../../styles/services.css';
const enquiry = { message: "Hi! I'd like to discuss Salsa, Bachata or a DJ set for an event. Can we talk about the date, location and guests?", label: 'Discuss your event' };
const waUrl = whatsappUrl(enquiry.message);
---
<BaseLayout title="Salsa & Bachata Event Hire — Workshops & DJs" description="Salsa and Bachata workshops and DJ hire for birthdays, hen and stag parties, community events and festivals in Milton Keynes, Leicester, Reading and nearby areas." enquiry={enquiry}>
  <ServiceHero eyebrow="Event hire" title="Salsa & Bachata for your event" href={waUrl} label="Tell us about your event on WhatsApp">
    <p>A tailored Latin dance experience for celebrations, community events and dance gatherings in Milton Keynes, Leicester and Reading.</p>
  </ServiceHero>
  <div class="service-shell pt-8">
    <p class="service-copy">Dance workshops, guest teaching and DJ sets—booked individually or combined around your event.</p>
    <nav class="service-jumps" aria-label="Event services"><a href="#workshops">Workshops</a><a href="#guest-teaching">Guest teaching</a><a href="#dj-sets">DJ sets</a></nav>
  </div>
  <section class="service-section">
    <div class="service-shell service-grid">
      <div><h2>Start with your occasion</h2><p>Bring your guests together through music and movement. Whether they’re discovering Latin dance for the first time or already enjoy social dancing, we’ll discuss an experience that suits your occasion.</p><p>Tell us who is coming, what you’re organising and how you would like dancing to fit into the event.</p><p>You might want an introduction that gets guests joining in, a dedicated workshop or guest teaching for an existing dance event.</p><p>We’ll shape the session around your audience rather than fit your event into a standard package.</p></div>
      <aside class="service-card"><h2>Choose the style—or ask us for ideas</h2><p>We offer Salsa and Bachata, including cross-body and Cuban Salsa.</p><p>For newcomers, we can focus on accessible movements and enjoying the music. For an experienced dance audience, we can discuss a more focused workshop.</p><p>Not sure which direction to take? Tell us about your guests and we’ll help you choose.</p></aside>
    </div>
  </section>
  <section id="workshops" class="service-section soft">
    <div class="service-shell">
      <h2>Dance workshops for your occasion</h2>
      <p class="service-copy mb-8">Tailored Salsa and Bachata workshops for birthdays, hen and stag parties, community events and local festivals. Corporate workshops and guest teaching for dance events are also available.</p>
      <div class="service-grid">
        <article class="service-card"><h3>For celebrations and community events</h3><p>A shared dance activity gives guests something to take part in together.</p><p>We can discuss a welcoming introduction for your group, with the content and pace agreed around the occasion. You don’t need to organise experienced dancers or ask everyone to bring a partner.</p></article>
        <article id="guest-teaching" class="service-card"><h3>For dance organisers</h3><p>Planning a social, workshop or festival? Speak to us about guest teaching.</p><p>Tell us the dance style, expected level and place of the workshop in your programme. We’ll discuss suitable content and availability before agreeing the booking.</p></article>
      </div>
      <a class="service-link" href="/services/corporate/">Explore corporate workshops →</a>
    </div>
  </section>
  <section class="service-section">
    <div class="service-shell service-grid">
      <div><h2>A package built around your event</h2><p>We agree the duration, teaching format and practical requirements with you.</p><p>Your quote will explain the agreed service and inclusions. We’ll discuss the venue, space, music and sound arrangements so responsibilities are clear before the event.</p></div>
      <div id="dj-sets" class="service-card"><h2>DJ sets</h2><p>Book a DJ set on its own or combine it with a dance workshop. We’ll discuss the music and format to suit your event.</p><h3 class="mt-6">Sound arrangements</h3><p>We can bring our own speakers for smaller events. For larger events, the venue will need to provide a suitable PA system. We’ll agree the sound arrangements with you beforehand.</p></div>
    </div>
  </section>
  <section class="service-section soft">
    <div class="service-shell service-copy center">
      <h2>Where we work</h2><p>Available in Milton Keynes, Leicester and Reading, and surrounding areas. Bookings further afield across the UK are considered by arrangement. Any travel or venue costs will be agreed as part of your quote.</p><p>Send us your event location—even if the venue is still being decided—and we’ll discuss what is possible.</p>
    </div>
  </section>
  <ServiceContact title="Let’s plan something that fits" href={waUrl} label="Discuss your event on WhatsApp">
    <p>To get started, send us:</p>
    <ul class="service-enquiry-list text-left"><li>Your event type and preferred date.</li><li>The town or venue.</li><li>An approximate number of guests.</li><li>Any ideas you already have.</li></ul>
    <p class="mt-6">You don’t need to have everything worked out before contacting us.</p>
  </ServiceContact>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Service', name: 'Salsa and Bachata Event Hire',
    url: 'https://latinaddiction.co.uk/services/hire-us/', serviceType: 'Latin dance event workshops and DJ hire',
    provider: { '@type': 'Organization', '@id': 'https://latinaddiction.co.uk/#organization', name: 'Latin Addiction', url: 'https://latinaddiction.co.uk' },
    areaServed: ['Milton Keynes', 'Leicester', 'Reading'],
    description: 'Tailored Salsa and Bachata workshops for birthdays, hen and stag parties, community events and festivals. DJ sets available independently or alongside a workshop.'
  })} />
</BaseLayout>
