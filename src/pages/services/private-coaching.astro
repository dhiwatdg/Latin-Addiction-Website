---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { coachingOffers, formatPrice } from '../../data/pricing';
import { whatsappUrl } from '../../data/locations';
import '../../styles/booking.css';
const waUrl = whatsappUrl("Hi! I'd like to arrange private Bachata coaching. My preferred city is ... and I'd like to work on ...");
---
<BaseLayout title="Private Bachata coaching" description="Solo and couples Bachata coaching from £50. Agree your date, time and location with us before paying. Milton Keynes, Leicester and Reading." showStickyBar={false}>
<div class="booking-page">
  <header class="booking-hero"><div class="booking-shell">
    <h1>Time to focus on your dancing.</h1>
    <p>Private Bachata coaching for you or you and your partner. Work on technique, connection, musicality or confidence, at your own pace.</p>
    <a class="btn-rose" href={waUrl}>Arrange coaching on WhatsApp</a>
    <a class="booking-text-link light" href="#pricing">See session prices ↓</a>
  </div></header>
  <div class="booking-shell booking-content">
    <section class="booking-section"><h2>Agree your session before you pay.</h2>
      <ol class="coaching-steps">
        <li><strong>Tell us what you need.</strong> Share your city, availability and what you would like to work on.</li>
        <li><strong>Agree the details together.</strong> We will confirm the date, time, location, session length and price.</li>
        <li><strong>Then pay through SumUp.</strong> Once everything is agreed, we will direct you to the appropriate payment option.</li>
      </ol>
    </section>
    <section id="pricing" class="booking-section"><h2>Choose the time you need.</h2><p>Prices below are the total for the session or pack. Couple prices cover both people. Availability must be confirmed first.</p>
      <div class="pass-options">{(['Solo', 'Couple'] as const).map(audience => <section class="pass-option">
        <h3>{audience === 'Solo' ? 'Just you' : 'You and your partner'}</h3>
        <table><caption class="sr-only">{audience} private coaching prices</caption><thead><tr><th scope="col">Session</th><th scope="col">Total price</th></tr></thead><tbody>
          {coachingOffers.filter(offer => offer.audience === audience).map(offer => <tr><th scope="row">{offer.sessions === 1 ? `${offer.minutes} minutes` : `${offer.sessions} × ${offer.minutes} minutes`}{offer.minutes === 60 && <small class="block">Subject to availability</small>}</th><td>{formatPrice(offer.amountPence)}</td></tr>)}
        </tbody></table>
        <a class="booking-text-link" href={whatsappUrl(`Hi! I'd like to arrange ${audience.toLowerCase()} private Bachata coaching. Can we discuss availability?`)}>Ask about {audience.toLowerCase()} coaching →</a>
      </section>)}</div>
    </section>
    <section class="booking-section"><h2>Where we can meet.</h2><p>Coaching is available by arrangement in Milton Keynes, Leicester and Reading. We will confirm a suitable venue before payment. Other locations may involve travel or venue costs, which we will agree with you first.</p></section>
    <section class="booking-section"><h2>Before you book.</h2>
      <details class="booking-details"><summary>How do four-session packs work?</summary><p>Each pack includes four sessions of your chosen length. We will discuss the schedule and any completion deadline individually when arranging payment.</p></details>
      <details class="booking-details"><summary>What if I need to change or cancel?</summary><p>Give at least 48 hours’ notice for a free change, or a full refund of a single session. For later changes or cancellations, a charge may reflect reasonable direct losses after any replacement booking. Unused pack value can be refunded less reasonable losses; sessions already taught are not refundable. Your statutory rights are unaffected.</p></details>
    </section>
    <aside class="booking-help"><h2>Let’s find the right session.</h2><p>You do not need to choose a pack before talking to us. Tell us where you are with your dancing and we will help.</p><a class="btn-rose" href={waUrl}>Arrange coaching on WhatsApp</a><p><a class="booking-text-link" href="/pricing/">Looking for group classes instead?</a></p></aside>
  </div>
</div>
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Service",name:"Private Bachata Coaching",provider:{"@type":"Organization",name:"Latin Addiction UK",url:"https://latinaddiction.co.uk"},areaServed:["Milton Keynes","Leicester","Reading"],offers:coachingOffers.map(offer=>({"@type":"Offer",name:`${offer.audience}: ${offer.sessions} × ${offer.minutes} minutes`,price:offer.amountPence/100,priceCurrency:"GBP"}))})}/>
</BaseLayout>
