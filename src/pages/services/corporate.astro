---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import ServiceContact from '../../components/ServiceContact.astro';
import { whatsappUrl } from '../../data/locations';
import '../../styles/services.css';
const enquiry = { message: "Hi! I'm interested in a corporate Salsa or Bachata workshop. Can we discuss the date, location and group size?", label: 'Discuss your corporate event' };
const waUrl = whatsappUrl(enquiry.message);
---
<BaseLayout title="Corporate Salsa & Bachata Workshops" description="Tailored corporate Salsa and Bachata workshops in Milton Keynes, Leicester, Reading and surrounding areas. Discuss your team event and get a bespoke quote." enquiry={enquiry}>
  <ServiceHero eyebrow="Corporate workshops" title="Salsa & Bachata workshops for corporate events" href={waUrl} label="Discuss your corporate event on WhatsApp">
    <p>Bring your team together through Latin dance in Milton Keynes, Leicester and Reading.</p>
    <p>No dance experience needed.</p>
  </ServiceHero>
  <section class="service-section">
    <div class="service-shell service-grid">
      <div class="service-copy"><h2>An experience shaped around your team</h2><p>Give colleagues something to share beyond the usual working day. Latin Addiction creates welcoming Salsa and Bachata sessions shaped around your team, your occasion and the time you have available.</p><p>You might be planning a team activity, an away day or a company celebration. We’ll help you find a format that fits.</p><p>A session could introduce everyone to a few accessible steps, give your team more time to learn together or make dancing part of a wider event.</p><p>We agree the format with you rather than asking you to choose a fixed package.</p></div>
      <aside class="service-card"><h2>Salsa, Bachata or a little of both</h2><p>We offer Salsa—including cross-body and Cuban styles—and Bachata.</p><p>You don’t need to know which style to choose before getting in touch. Tell us about your group and the atmosphere you want to create, and we’ll suggest an approach.</p></aside>
    </div>
  </section>
  <section class="service-section soft">
    <div class="service-shell service-grid">
      <div><h2>What taking part looks like</h2><p>We introduce the movements, break them into manageable steps and give people time to practise.</p><p>You don’t need to arrive with a dance partner. Let us know about your group’s preferences and any access requirements so we can discuss a suitable session.</p></div>
      <div><h2>Your event, your location</h2><p>Available in Milton Keynes, Leicester and Reading, and surrounding areas. Bookings further afield across the UK are considered by arrangement. Any travel or venue costs will be agreed as part of your quote.</p><p>We’ll also discuss the available space and sound arrangements before agreeing the booking.</p></div>
    </div>
  </section>
  <section class="service-section">
    <div class="service-shell">
      <h2>How it works</h2>
      <ol class="service-steps">
        <li><strong>Tell us about your event.</strong>Share your preferred date, location, approximate group size and what you’re planning.</li>
        <li><strong>Shape the session together.</strong>We’ll discuss the dance styles, duration and practical arrangements.</li>
        <li><strong>Review your tailored quote.</strong>You’ll know what is included and what needs to be arranged before deciding.</li>
      </ol>
    </div>
  </section>
  <section class="service-section soft">
    <div class="service-shell service-copy center">
      <h2>A few useful answers</h2>
      <div class="service-faq">
        <details><summary>Does everyone need dance experience?</summary><p>No. We can plan an introduction for complete beginners. Tell us if your group includes experienced dancers too.</p></details>
        <details><summary>How long is a workshop?</summary><p>We agree the duration around your programme and what you want the group to experience.</p></details>
        <details><summary>How much does it cost?</summary><p>We quote for your event, taking account of the session, location, group and agreed requirements.</p></details>
      </div>
    </div>
  </section>
  <ServiceContact title="Tell us what you’re planning" href={waUrl} label="Discuss your corporate event on WhatsApp">
    <p>A rough idea is enough to start the conversation.</p>
  </ServiceContact>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Service', name: 'Corporate Salsa and Bachata Workshops',
    url: 'https://latinaddiction.co.uk/services/corporate/', serviceType: 'Corporate Latin dance workshops',
    provider: { '@type': 'Organization', '@id': 'https://latinaddiction.co.uk/#organization', name: 'Latin Addiction', url: 'https://latinaddiction.co.uk' },
    areaServed: ['Milton Keynes', 'Leicester', 'Reading'],
    description: 'Tailored Salsa and Bachata workshops for corporate events, team activities and company celebrations. Duration and inclusions agreed individually.'
  })} />
</BaseLayout>
