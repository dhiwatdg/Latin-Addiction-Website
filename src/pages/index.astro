---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScheduleCard from '../components/ScheduleCard.astro';
import { locations, whatsappUrl } from '../data/locations';
import { reviews, reviewExcerpt, READING_GOOGLE_RATING } from '../data/reviews';
import { homepageFaqs } from '../data/faqs';
import '../styles/home.css';

const waUrl = whatsappUrl();
const featuredReview = reviews.find((r) => r.featured)!;
const panelId = (slug: string) => slug === 'milton-keynes' ? 'mk' : slug;
---

<BaseLayout
  title="Bachata Classes in Milton Keynes, Leicester & Reading"
  description="Learn Bachata with Latin Addiction UK. Free first class, no partner needed. Weekly classes in Milton Keynes (Mon), Leicester (Tue) & Reading (Wed)."
>
  {/* ── SECTION 1: HERO (dark bg) ── */}
  <section class="hero-section relative overflow-hidden bg-dark text-white flex items-center min-h-[85vh] md:min-h-[92vh] px-5 py-14 md:px-8 md:py-20 lg:px-8 lg:py-24">
    {/* Decorative radial gradient glows */}
    <div class="hero-glow-left" aria-hidden="true"></div>
    <div class="hero-glow-right" aria-hidden="true"></div>

    <div class="relative z-10 max-w-[1200px] mx-auto w-full text-center md:text-left">
      {/* Eyebrow */}
      <div data-reveal class="flex items-center gap-3 mb-3 justify-center md:justify-start">
        <span class="hidden md:block w-12 h-[3px] bg-rose-light rounded-sm" aria-hidden="true"></span>
        <span class="text-rose-light uppercase text-xs font-bold tracking-[0.12em]">
          Bachata dance classes · UK
        </span>
      </div>

      {/* H1 */}
      <h1 data-reveal data-reveal-delay="1" class="font-display font-extrabold text-white leading-[1.02] tracking-[-0.02em] mb-5 text-[clamp(3rem,8vw,5.5rem)]">
        No partner needed.<br />
        No experience needed.<br />
        <em class="not-italic text-rose">Your first class is free.</em>
      </h1>

      {/* Subtitle */}
      <p data-reveal data-reveal-delay="2" class="font-body font-light text-[clamp(1rem,2vw,1.15rem)] text-white/60 leading-[1.7] max-w-[520px] mb-8 mx-auto md:mx-0">
        Bachata classes in Milton Keynes, Leicester &amp; Reading — the Latin partner dance everyone's falling for.
      </p>

      {/* CTA buttons */}
      <div data-reveal data-reveal-delay="3" class="flex flex-wrap gap-3 mb-5 justify-center md:justify-start">
        <a
          href={waUrl}
          class="btn-rose"
          target="_blank"
          rel="noopener"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.611.611l4.458-1.495A11.96 11.96 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.336 0-4.512-.703-6.32-1.905l-.44-.303-2.882.966.966-2.882-.303-.44A9.935 9.935 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
          </svg>
          Ask about your free class
        </a>
        <a href="#schedule" class="btn-white-outline">
          See classes &amp; times ↓
        </a>
      </div>

      <p data-reveal data-reveal-delay="4" class="text-[0.85rem] text-white/75 max-w-[560px] mx-auto md:mx-0">
        No advance booking needed. Walk-ins welcome. Message us if you have questions.
      </p>

      {/* Trust bar */}
      <div data-reveal data-reveal-delay="4" class="flex flex-wrap gap-5 pt-6 mt-10 border-t border-white/[0.08] justify-center md:justify-start">
        <span class="text-[0.82rem] text-white/65 flex items-center gap-1.5">
          <span class="text-gold">★</span> {READING_GOOGLE_RATING.value} on Google · Reading
        </span>
        <span class="text-[0.82rem] text-white/65">3 cities</span>
        <span class="text-[0.82rem] text-white/65">100+ students weekly</span>
        <span class="text-[0.82rem] text-white/65">4+ years running</span>
        <span class="text-[0.82rem] text-white/65">Free social after every class</span>
      </div>
    </div>
  </section>

  {/* ── CLASSES: practical information comes first ── */}
  <section id="schedule" class="bg-[#f5f5f5] px-5 py-14 md:px-8 md:py-20 lg:px-8 lg:py-24">
    <div class="max-w-[1200px] mx-auto">
      {/* Eyebrow */}
      <div data-reveal class="mb-3">
        <span class="text-rose uppercase text-[0.75rem] font-bold tracking-[0.12em]">
          Classes
        </span>
      </div>

      {/* Title */}
      <h2 data-reveal data-reveal-delay="1" class="font-display font-semibold text-[clamp(1.75rem,3.5vw,2.75rem)] leading-[1.12] mb-4">
        When &amp; where we dance
      </h2>

      <p data-reveal class="text-muted mb-6">Choose your city to see the timetable, venue and prices.</p>

      {/* Tab buttons */}
      <div data-reveal data-reveal-delay="2" class="home-city-tabs mb-5" role="tablist" aria-label="Choose a location">
        {locations.map((loc, i) => (
          <button
            id={`tab-${panelId(loc.slug)}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`p-${panelId(loc.slug)}`}
            class:list={[
              'schedule-tab home-city-tab font-body border-2 cursor-pointer',
              i === 0
                ? 'active-tab bg-rose text-white border-rose'
                : 'bg-transparent text-muted border-[rgba(225,29,72,0.25)]',
            ]}
            tabindex={i === 0 ? 0 : -1}
            data-loc={panelId(loc.slug)}
          >
            <span class="home-city-name">{loc.name}</span>
            <span class="home-city-time">{loc.day} · {loc.schedule[1].time}<span class="home-city-beginner"> Beginners</span></span>
          </button>
        ))}
      </div>

      {/* Tab panels */}
      {locations.map((loc, i) => (
        <div
          data-reveal
          data-reveal-delay="3"
          id={`p-${panelId(loc.slug)}`}
          role="tabpanel"
          aria-labelledby={`tab-${panelId(loc.slug)}`}
          class:list={['schedule-panel', i !== 0 && 'hidden']}
        >
          <ScheduleCard location={loc} />

          {/* Location note (MK only) */}
          {loc.note && (
            <p class="text-[0.85rem] text-muted italic mt-3">{loc.note}</p>
          )}

          {/* Per-location CTA */}
          <div class:list={[loc.note ? 'mt-4' : 'mt-5', 'flex flex-wrap items-center gap-3']}>
            <a
              href={whatsappUrl(loc.whatsappMessage)}
              class="btn-rose"
              target="_blank"
              rel="noopener"
            >
              Ask about your first class
            </a>
            <a href={`/pricing/#${loc.slug}`} class="inline-flex min-h-[44px] items-center px-4 py-2 text-rose-dark font-semibold underline underline-offset-4">See {loc.name} prices &amp; passes →</a>
          </div>
        </div>
      ))}

      <div data-reveal class="home-trial-note">
        <p>Your first beginner class is free, once per person across Latin Addiction. After your trial, the £20 newcomer pass covers four consecutive paid beginner weeks in your chosen city.</p>
        <p class="text-muted mt-2 text-sm">Cash and card accepted. £2 Student &amp; NHS discount at the door only. <a href="/pricing/" class="home-text-link">See all pricing →</a></p>
      </div>
    </div>
  </section>

  <section class="home-section bg-white" aria-labelledby="first-night-title">
    <div class="home-shell">
      <h2 id="first-night-title" class="home-heading">Your first night, made simple</h2>
      <p class="home-intro">Come as you are. We’ll help you get started.</p>
      <div class="home-first-night">
        <div><h3>No partner needed</h3><p>Come on your own, with a friend or as a couple. We rotate partners during class.</p></div>
        <div><h3>No experience needed</h3><p>Join the beginner class for the rhythm, basic steps and your first partner moves. Wear comfortable clothes you can move in.</p></div>
        <div><h3>Stay for the social</h3><p>After the classes, enjoy free social dancing and practise what you’ve learned.</p></div>
      </div>
      <p class="home-experienced"><strong>Already dance Bachata?</strong> Choose a class that suits your experience. If you’re unsure, <a href={whatsappUrl("Hi! I'm not sure which level to join")} class="home-text-link" target="_blank" rel="noopener">ask us which level to join</a>.</p>
    </div>
  </section>

  <section class="home-section bg-[#f5f5f5]" aria-labelledby="teaching-title">
    <div class="home-shell home-teaching">
      <div class="home-founders">
        <img src="/images/optimised/founders-400.webp" srcset="/images/optimised/founders-400.webp 400w, /images/optimised/founders-800.webp 800w" sizes="(min-width:768px) 180px, 112px" width="400" height="596" loading="lazy" alt="Dhiwa and Gloria, co-founders of Latin Addiction" />
        <div>
          <h2 id="teaching-title" class="home-heading">Friendly teaching. Technique you can build on.</h2>
          <p>Founded by Dhiwa and Gloria in July 2021, Latin Addiction brings together a welcoming Bachata community across Milton Keynes, Leicester and Reading. Our teaching focuses on technique, partner connection, dancer safety and enjoying the music.</p>
          <a href="/about/" class="home-text-link">Meet Dhiwa, Gloria &amp; the team →</a>
        </div>
      </div>
      <figure class="home-review">
        <div class="text-gold tracking-widest mb-4" aria-label="5 out of 5 stars">★★★★★</div>
        <blockquote>“{reviewExcerpt(featuredReview.text)}”</blockquote>
        <figcaption>{featuredReview.author} · Google review excerpt</figcaption>
        <a href="/reviews/">Read more student reviews →</a>
      </figure>
    </div>
  </section>

  <section class="home-section bg-white" aria-labelledby="services-title">
    <div class="home-shell home-services">
      <div>
        <p class="home-eyebrow">Looking for something different?</p>
        <h2 id="services-title" class="home-heading">Salsa &amp; Bachata beyond weekly classes</h2>
        <p>Our weekly classes focus on Bachata. For private lessons, corporate workshops and event bookings, we can tailor Salsa, Bachata or a combination to your needs.</p>
      </div>
      <nav class="home-service-links" aria-label="Other dance services">
        <a href="/services/private-coaching/">Private Salsa &amp; Bachata lessons <span aria-hidden="true">↗</span></a>
        <a href="/services/corporate/">Corporate workshops <span aria-hidden="true">↗</span></a>
        <a href="/services/hire-us/">Event workshops &amp; DJ hire <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </section>

  {/* ── SECTION 7: FAQ (white bg) ── */}
  <section class="bg-white px-5 py-14 md:px-8 md:py-20 lg:px-8 lg:py-24">
    <div class="max-w-[760px] mx-auto">
      {/* Eyebrow */}
      <div data-reveal class="text-center mb-3">
        <span class="text-rose uppercase text-[0.75rem] font-bold tracking-[0.12em]">
          FAQ
        </span>
      </div>

      {/* Title */}
      <h2 data-reveal data-reveal-delay="1" class="font-display font-semibold text-[clamp(1.75rem,3.5vw,2.75rem)] leading-[1.12] text-center mb-4">
        A few useful answers
      </h2>

      {/* Accordion */}
      <div class="mt-5">
        {homepageFaqs.map((faq, i) => (
          <div data-reveal class="bg-[#f5f5f5] border border-[rgba(225,29,72,0.06)] rounded-[16px] overflow-hidden mb-2.5">
            <button
              id={`faq-btn-${i}`}
              class="faq-btn w-full flex items-center justify-between gap-4 text-left cursor-pointer bg-transparent border-none"
              style="padding:1rem 1.25rem;"
              aria-expanded="false"
              aria-controls={`faq-answer-${i}`}
            >
              <span class="font-body font-semibold text-[0.9rem] text-dark">{faq.question}</span>
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div
              id={`faq-answer-${i}`}
              class="faq-answer hidden"
              role="region"
              aria-labelledby={`faq-btn-${i}`}
            >
              <p class="text-[0.88rem] text-muted leading-[1.7]" style="padding:0 1.25rem 1rem;">
                {faq.answer}
              </p>
            </div>
          </div>
        ))}
      </div>

      {/* See all FAQs link */}
      <p class="text-center mt-3">
        <a href="/faq" class="text-rose-dark font-medium text-[0.88rem] no-underline hover:underline">
          See all FAQs &rarr;
        </a>
      </p>
    </div>
  </section>

  <section class="home-section home-closing bg-dark text-white">
    <div class="home-shell text-center">
      <h2 class="home-heading text-white">Your first Bachata class is free.</h2>
      <p>Choose your city and come along. No partner or experience needed.</p>
      <div class="flex flex-wrap justify-center gap-3 mt-6">
        <a href="#schedule" class="btn-rose">Find your class</a>
        <a href={whatsappUrl('Hi! I have a question about Latin Addiction.')} class="btn-white-outline" target="_blank" rel="noopener">Ask us on WhatsApp</a>
      </div>
    </div>
  </section>
  <noscript><style>.schedule-panel.hidden,.faq-answer.hidden{display:block!important}.schedule-tab{display:none!important}</style></noscript>
</BaseLayout>

<script>
  document.querySelectorAll('.schedule-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      // Deactivate all tabs
      document.querySelectorAll('.schedule-tab').forEach(t => {
        t.classList.remove('active-tab', 'bg-rose', 'text-white', 'border-rose');
        t.classList.add('bg-transparent', 'text-muted', 'border-[rgba(225,29,72,0.25)]');
        t.setAttribute('aria-selected', 'false');
        t.setAttribute('tabindex', '-1');
      });
      // Hide all panels
      document.querySelectorAll('.schedule-panel').forEach(p => p.classList.add('hidden'));

      // Activate clicked tab
      tab.classList.add('active-tab', 'bg-rose', 'text-white', 'border-rose');
      tab.classList.remove('bg-transparent', 'text-muted', 'border-[rgba(225,29,72,0.25)]');
      tab.setAttribute('aria-selected', 'true');
      tab.setAttribute('tabindex', '0');

      // Show matching panel
      const loc = (tab as HTMLElement).dataset.loc;
      document.getElementById('p-' + loc)?.classList.remove('hidden');
    });
  });

  const scheduleTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.schedule-tab'));
  scheduleTabs.forEach((tab, index) => {
    tab.tabIndex = tab.getAttribute('aria-selected') === 'true' ? 0 : -1;
    tab.addEventListener('keydown', (event) => {
      const next = event.key === 'ArrowRight' ? (index + 1) % scheduleTabs.length : event.key === 'ArrowLeft' ? (index + scheduleTabs.length - 1) % scheduleTabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? scheduleTabs.length - 1 : null;
      if (next !== null) { event.preventDefault(); scheduleTabs[next].click(); scheduleTabs[next].focus(); }
    });
  });
  // FAQ accordion — single open at a time
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling as HTMLElement;
      const chevron = btn.querySelector('.faq-chevron') as SVGElement;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all
      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-chevron').forEach(c => c.classList.remove('rotated'));
      document.querySelectorAll('.faq-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));

      // Open clicked (if it was closed)
      if (!isOpen) {
        answer.classList.remove('hidden');
        chevron.classList.add('rotated');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
