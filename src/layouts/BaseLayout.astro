---
import SEO from '../components/SEO.astro';
import { organization } from '../data/structured-data';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import { whatsappUrl } from '../data/locations';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  minimal?: boolean;
  showStickyBar?: boolean;
  showFloatingWhatsApp?: boolean;
  enquiry?: { message: string; label: string };
  whatsappAction?: { message: string; label: string };
}

const { title, description, canonical, ogImage, minimal = false, showStickyBar = true, showFloatingWhatsApp = true, enquiry, whatsappAction } = Astro.props;
const contactHref = enquiry ? whatsappUrl(enquiry.message) : undefined;
// Contextual controls must not replace the header navigation or general footer contact.
const action = whatsappAction ?? enquiry;
const actionHref = action ? whatsappUrl(action.message) : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <SEO title={title} description={description} canonical={canonical} ogImage={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...organization })} />
  </head>
  <body class:list={["font-body text-dark leading-relaxed", !minimal && showStickyBar && "has-mobile-cta"]}>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[999] focus:bg-rose focus:text-white focus:px-4 focus:py-2 focus:rounded-full focus:text-sm focus:font-semibold">
      Skip to content
    </a>
    {!minimal && <Header enquiryHref={contactHref} />}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {!minimal && <Footer contactHref={contactHref} />}
    {!minimal && showFloatingWhatsApp && <WhatsAppButton href={actionHref} label={action?.label} />}
    {!minimal && showStickyBar && <MobileStickyBar href={actionHref} label={action?.label} />}

  </body>
</html>
